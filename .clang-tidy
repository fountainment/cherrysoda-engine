# CherrySoda Engine clang-tidy configuration.
#
# Philosophy (borrowed from the fountain2 engine): high signal, low noise,
# non-blocking. Findings are report-only (WarningsAsErrors is empty) — they do
# not gate CI. The intent is to keep real bug patterns (bugprone-*),
# performance traps (performance-*) and modernization opportunities visible
# while development iterates, not to force a big-bang cleanup.
#
# How to run (clang-tidy needs a compile_commands.json — every preset exports
# one into out/build/<preset>/; use the Homebrew LLVM binary, /opt/homebrew/
# opt/llvm/bin, and add the macOS SDK because Homebrew clang-tidy does not
# resolve Apple-clang sysroots by itself):
#
#   cmake --preset unix-debug
#   /opt/homebrew/opt/llvm/bin/run-clang-tidy \
#     -clang-tidy-binary /opt/homebrew/opt/llvm/bin/clang-tidy \
#     -clang-apply-replacements-binary /opt/homebrew/opt/llvm/bin/clang-apply-replacements \
#     -p out/build/unix-debug \
#     -extra-arg="-isysroot$(xcrun --show-sdk-path)" \
#     '/cherrysoda-engine/(Engine/CherrySoda|Examples|Playground|Bench|Tests|Tools/ParticleEditor|Tools/sfxr_port/src/(Program|sfxr_port))/.*\.cpp$'
#
#   The sweep covers every first-party TU: the engine, the sample apps
#   (Examples, Playground, Bench, Tests) and the authored tool sources
#   (Tools/ParticleEditor, Tools/sfxr_port wrappers). Vendored trees under
#   Tools/ (crunch, sfxr_port/src/sfxr) are never swept, matching the
#   clang-format exclusions.
#
# Editors (clangd) also analyze each header standalone, so sweep the headers
# the same way to keep the in-editor view clean:
#
#   for h in $(find Engine/CherrySoda Examples Playground Bench Tests Tools/ParticleEditor Tools/sfxr_port/src \
#     -name '*.h' | grep -v embedded_shaders); do
#     /opt/homebrew/opt/llvm/bin/clang-tidy -p out/build/unix-debug \
#       -extra-arg="-isysroot$(xcrun --show-sdk-path)" "$h"
#   done
#
# Never run clang-tidy -fix over the headers in parallel: concurrent runs
# rewrite shared headers interleaved and corrupt them.
#
# The engine builds without PCH or unity files, so no extra flags are needed
# for tidy to see every TU.
#
# Disabled checks and why (re-enabling one is welcome after the corresponding
# cleanup pass lands):
#
#   modernize-use-trailing-return-type      engine uses leading return types
#                                           everywhere; converting every
#                                           signature is pure churn
#   modernize-avoid-c-style-cast            Monocle-heritage code uses C-style
#                                           casts pervasively; needs a
#                                           dedicated cleanup pass first
#   readability-isolate-declaration         `float r, g, b;` is an intentional
#                                           idiom in color/vector math
#   bugprone-signed-bitwise                 integer-promotion noise on BitTag
#                                           masks and SDL bitfields
#   readability-magic-numbers               math/engine code legitimately uses
#                                           raw numeric literals everywhere
#   bugprone-easily-swappable-parameters    (float a, float b) is the norm in
#                                           geometry code
#   readability-identifier-naming           engine has its own convention
#                                           (m_ members, PascalCase methods);
#                                           full naming config deferred
#   readability-function-cognitive-complexity dense Entity::Update bodies are
#                                           inherited style
#   readability-braces-around-statements   one-line unbraced `if (x) y;` is an
#                                           accepted style here (matches the
#                                           clang-format config)
#   readability-identifier-length          short names (i, j, x, y) are
#                                           idiomatic in math/loop code
#   misc-non-private-member-variables-in-classes  Entity/Component expose
#                                           protected state by design
#   misc-include-cleaner                    include churn too large for now
#   bugprone-narrowing-conversions,         fired from inside SDL3 macros;
#   cert-err34-c, cert-err58-cpp            not actionable from engine code
#   readability-uppercase-literal-suffix     house style is lowercase literal
#                                           suffixes (`1.f`, `10u`) everywhere;
#                                           converting them is pure churn
#   readability-implicit-bool-conversion     pointer/float truthiness (`if (ptr)`,
#                                           `if (Get(x, y))`) is the Monocle
#                                           heritage idiom
#   modernize-use-using                      C-style `typedef` aliases are the
#                                           documented engine convention
#   readability-avoid-nested-conditional-operator  chained sign/step ternaries
#                                           in grid traversal math are house
#                                           style
#   misc-no-recursion                        the recursive command trie and
#                                           atlas-data walkers are intentional
#   misc-use-anonymous-namespace                engine style spells file-local
#                                           linkage as `static` (the companion
#                                           misc-use-internal-linkage check is
#                                           kept enabled and clean); wrapping
#                                           the same declarations in anonymous
#                                           namespaces is pure re-spelling
#   misc-const-correctness                   auto-fix emits east-const
#                                           (`int const x`), clashing with the
#                                           west-const style used everywhere;
#                                           a hand-written west-const pass would
#                                           be welcome before re-enabling
#   bugprone-reserved-identifier              `_CHERRYSODA_…_H_` include guards
#                                           are the documented engine convention
#                                           (and embedded_shaders.h is generated
#                                           by Tools/compile_shader.py with the
#                                           same guard spelling); the cert-dcl37-c
#                                           /cert-dcl51-cpp aliases of the check
#                                           must be disabled too or they keep
#                                           firing on the same guards
#   modernize-avoid-c-arrays                  fixed C buffers interop with SDL/
#                                           bgfx/cmixer APIs and use sizeof/
#                                           decay semantics; a std::array sweep
#                                           is welcome before re-enabling
#   cert-dcl03-c, misc-static-assert          fires on runtime conditions passed
#                                           through the CHERRYSODA_ASSERT macro
#                                           (suggesting static_assert(false)
#                                           on deliberate runtime guards)
#   readability-trailing-comma                besides generated embedded_shaders
#                                           headers (which must not be hand-
#                                           edited), the comma insertions are
#                                           pure style churn
#   readability-redundant-inline-specifier    explicit `inline` on in-class
#                                           member definitions is deliberate
#                                           house style (see Math.h, STL.h,
#                                           Camera.h); stripping ~1200 of them
#                                           is pure churn
#   modernize-use-nodiscard                   suggests [[nodiscard]] on
#                                           essentially every const getter;
#                                           adding ~950 attributes is churn the
#                                           engine has never asked for
#   bugprone-macro-parentheses                the house macros (Math.h, Log.h)
#                                           define function signatures from
#                                           parameters; the check and its fixit
#                                           misread those as value expressions
#                                           and corrupt the signatures
#   misc-explicit-constructor                 single-argument constructors and
#                                           conversion operators (StringID,
#                                           Color, MTexture) implement
#                                           deliberate implicit-conversion
#                                           ergonomics
#   performance-enum-size                     shrinking enum base types changes
#                                           struct sizes; needs a deliberate
#                                           layout pass, not an auto-fix
#   modernize-use-std-numbers                 the engine spells its constants in
#                                           Math (Math::Pi, Math::PiHalf …);
#                                           rewriting raw literals to
#                                           std::numbers fights that

Checks:
  '-*,
   bugprone-*,
   cert-*,
   cppcoreguidelines-init-variables,
   cppcoreguidelines-pro-type-member-init,
   cppcoreguidelines-slicing,
   misc-*,
   modernize-*,
   performance-*,
   portability-*,
   readability-*,
   -modernize-use-trailing-return-type,
   -modernize-avoid-c-style-cast,
   -readability-isolate-declaration,
   -bugprone-signed-bitwise,
   -readability-magic-numbers,
   -bugprone-easily-swappable-parameters,
   -readability-identifier-naming,
   -readability-function-cognitive-complexity,
   -readability-braces-around-statements,
   -readability-identifier-length,
   -misc-non-private-member-variables-in-classes,
   -misc-include-cleaner,
   -bugprone-narrowing-conversions,
   -cert-err34-c,
   -cert-err58-cpp,
   -readability-uppercase-literal-suffix,
   -readability-implicit-bool-conversion,
   -modernize-use-using,
   -readability-avoid-nested-conditional-operator,
   -misc-no-recursion,
   -misc-const-correctness,
   -misc-use-anonymous-namespace,
   -bugprone-reserved-identifier,
   -cert-dcl37-c,
   -cert-dcl51-cpp,
   -modernize-avoid-c-arrays,
   -cert-dcl03-c,
   -misc-static-assert,
   -readability-trailing-comma,
   -readability-redundant-inline-specifier,
   -modernize-use-nodiscard,
   -bugprone-macro-parentheses,
   -misc-explicit-constructor,
   -performance-enum-size,
   -modernize-use-std-numbers'

WarningsAsErrors: ''

# DeMorgan simplification is turned off inside simplify-boolean-expr: the
# negation lives in the CHERRYSODA_ASSERT macro body (`if (!(condition))`), so
# every assert whose condition is a conjunction gets flagged at its call site.
CheckOptions:
  - key: readability-simplify-boolean-expr.SimplifyDeMorgan
    value: false
# NOTE: keep this regex POSIX-ERE compatible (llvm::Regex does not support
# lookaheads), and match on the last path segment only — headers resolve
# through -I flags spelled like `Engine/.`, which puts a `./` between Engine
# and CherrySoda and would defeat an `Engine/CherrySoda/...` pattern.
# Generated embedded_shaders/ headers are excluded because they must never be
# hand-edited.
HeaderFilterRegex: '(CherrySoda|Examples|Playground|Bench|Tests|Tools)/.*\.h$'
ExcludeHeaderFilterRegex: 'embedded_shaders'

FormatStyle: file
